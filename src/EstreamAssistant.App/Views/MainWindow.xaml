<Window x:Class="EstreamAssistant.App.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:EstreamAssistant.App.ViewModels"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        mc:Ignorable="d"
        d:DataContext="{d:DesignInstance Type=vm:MainViewModel}"
        Title="eStream Assistant"
        Icon="pack://application:,,,/app.ico"
        Width="1280" Height="820" MinWidth="980" MinHeight="640"
        WindowStartupLocation="CenterScreen"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource Panel}" AllowDrop="True">

    <Window.Resources>
        <!-- One feed message: owner on the right (blue), app/assistant on the left. -->
        <DataTemplate x:Key="FeedItemTemplate" DataType="{x:Type vm:FeedMessage}">
            <Border x:Name="Bubble" CornerRadius="8" Padding="12,8" Margin="4,4,60,4"
                    HorizontalAlignment="Left" Background="{StaticResource AppBubble}"
                    BorderBrush="{StaticResource Border}" BorderThickness="1">
                <StackPanel>
                    <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6"
                                  Visibility="{Binding HasAttachments, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                                <Border CornerRadius="4" Margin="0,0,6,0" Background="#1F2A38" ToolTip="{Binding Name}">
                                    <Grid>
                                        <Image Source="{Binding Thumb}" MaxHeight="110" MaxWidth="96" Stretch="Uniform" />
                                        <TextBlock Text="{Binding Name, StringFormat=PDF: {0}}" Margin="8" MaxWidth="160" TextWrapping="Wrap" FontSize="13"
                                                   Visibility="{Binding IsPdf, Converter={StaticResource Visible}}" />
                                    </Grid>
                                </Border>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock x:Name="BubbleText" Text="{Binding Text}" TextWrapping="Wrap" FontSize="16" />
                    <TextBlock Text="{Binding Status}" FontSize="13" FontStyle="Italic" Foreground="{StaticResource Muted}" Margin="0,2,0,0"
                               Visibility="{Binding HasStatus, Converter={StaticResource Visible}}" />
                    <ItemsControl ItemsSource="{Binding Choices}" Margin="0,6,0,0"
                                  Visibility="{Binding HasChoices, Converter={StaticResource Visible}}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate DataType="{x:Type vm:FeedChoice}">
                                <Button Style="{StaticResource ChoiceButton}"
                                        Command="{Binding DataContext.ChooseCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                        CommandParameter="{Binding}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Number, StringFormat={}{0}.}" FontWeight="Bold" Width="28" />
                                        <StackPanel>
                                            <TextBlock Text="{Binding Label}" FontSize="16" />
                                            <TextBlock Text="{Binding Detail}" FontSize="12" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <TextBlock Text="{Binding TimeText}" FontSize="11" Foreground="{StaticResource Muted}"
                               HorizontalAlignment="Right" Margin="0,4,0,0" />
                </StackPanel>
            </Border>
            <DataTemplate.Triggers>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FeedKind.Owner}">
                    <Setter TargetName="Bubble" Property="HorizontalAlignment" Value="Right" />
                    <Setter TargetName="Bubble" Property="Margin" Value="60,4,4,4" />
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource OwnerBubble}" />
                    <Setter TargetName="Bubble" Property="BorderThickness" Value="0" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FeedKind.Assistant}">
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource AssistantBubble}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="#56705F" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Text}" Value="">
                    <Setter TargetName="BubbleText" Property="Visibility" Value="Collapsed" />
                </DataTrigger>
                <DataTrigger Binding="{Binding Kind}" Value="{x:Static vm:FeedKind.Error}">
                    <Setter TargetName="Bubble" Property="Background" Value="{StaticResource ErrorBubble}" />
                    <Setter TargetName="Bubble" Property="BorderBrush" Value="{StaticResource Danger}" />
                </DataTrigger>
            </DataTemplate.Triggers>
        </DataTemplate>
    </Window.Resources>

    <Grid>
    <DockPanel>
        <!-- Top bar: scan/search box + status lights -->
        <Border DockPanel.Dock="Top" Background="{StaticResource TopBarBg}" BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="12,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <Grid>
                    <TextBox x:Name="ScanBox" FontSize="22" MinHeight="46"
                             Text="{Binding ScanText, UpdateSourceTrigger=PropertyChanged}"
                             ToolTip="Scan a barcode, or type a UPC or item name and press Enter" />
                    <TextBlock Text="Scan a barcode, or type a UPC or item name…" FontSize="20" Margin="10,0"
                               VerticalAlignment="Center" Foreground="{StaticResource Placeholder}" IsHitTestVisible="False"
                               Visibility="{Binding Text, ElementName=ScanBox, Converter={StaticResource Hidden}}" />
                </Grid>
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <StackPanel Orientation="Horizontal" Margin="8,0" ToolTip="{Binding EStreamStatusText}">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding EStreamStatus, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="eStream" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0" ToolTip="{Binding DataStatusText}">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DataStatus, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="{Binding DataSourceName}" VerticalAlignment="Center" />
                    </StackPanel>
                    <StackPanel Orientation="Horizontal" Margin="8,0" ToolTip="{Binding ClaudeStatusText}">
                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding ClaudeStatus, Converter={StaticResource StatusBrush}}" />
                        <TextBlock Text="Claude" VerticalAlignment="Center" />
                    </StackPanel>
                </StackPanel>
            </Grid>
        </Border>

        <TabControl x:Name="Tabs" TabStripPlacement="Bottom" FontSize="15" BorderThickness="0" Background="{StaticResource Panel}">
            <!-- ===================== ASSISTANT ===================== -->
            <TabItem Header="  Assistant  ">
                <Grid Margin="6">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="4*" />
                    </Grid.ColumnDefinitions>

                    <!-- CHAT / activity feed -->
                    <Border Style="{StaticResource Card}" Padding="8">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="CHAT" Style="{StaticResource SectionTitle}" Margin="6,2,0,6" />
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <!-- Receipts that go with the next message (nothing is sent until Send) -->
                                <ItemsControl ItemsSource="{Binding Attachments}" Margin="0,0,0,6"
                                              Visibility="{Binding HasAttachments, Converter={StaticResource Visible}}">
                                    <ItemsControl.ItemsPanel>
                                        <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                    </ItemsControl.ItemsPanel>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:AttachmentViewModel}">
                                            <Border BorderBrush="{StaticResource Accent}" BorderThickness="1" CornerRadius="6" Padding="4" Margin="0,0,6,4"
                                                    Background="{StaticResource InputBg}">
                                                <DockPanel>
                                                    <Grid DockPanel.Dock="Left" Width="44" Height="44" Margin="0,0,6,0">
                                                        <Image Source="{Binding Thumb}" Stretch="UniformToFill" />
                                                        <TextBlock Text="PDF" FontWeight="Bold" HorizontalAlignment="Center" VerticalAlignment="Center"
                                                                   Visibility="{Binding IsPdf, Converter={StaticResource Visible}}" />
                                                    </Grid>
                                                    <Button DockPanel.Dock="Right" Content="×" Padding="6,0" MinHeight="24" FontSize="13" VerticalAlignment="Top"
                                                            ToolTip="Don't send this one"
                                                            Command="{Binding DataContext.RemoveAttachmentCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}" />
                                                    <StackPanel VerticalAlignment="Center" MaxWidth="200">
                                                        <TextBlock Text="{Binding Name}" FontSize="13" TextTrimming="CharacterEllipsis" />
                                                        <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                    </StackPanel>
                                                </DockPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <TextBox x:Name="ChatBox" MinHeight="40" MaxHeight="120" FontSize="16"
                                             TextWrapping="Wrap" AcceptsReturn="False" VerticalScrollBarVisibility="Auto"
                                             Text="{Binding ChatText, UpdateSourceTrigger=PropertyChanged}"
                                             ToolTip="Type a question for Claude and press Enter" />
                                    <TextBlock Text="{Binding ChatPlaceholder}" FontSize="15" Margin="10,0" VerticalAlignment="Center"
                                               Foreground="{StaticResource Placeholder}" IsHitTestVisible="False"
                                               Visibility="{Binding Text, ElementName=ChatBox, Converter={StaticResource Hidden}}" />
                                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                                        <Button Content="Send" Style="{StaticResource PrimaryButton}" Command="{Binding SendChatCommand}"
                                                Visibility="{Binding IsChatBusy, Converter={StaticResource Hidden}}" />
                                        <Button Content="Stop" Command="{Binding StopChatCommand}"
                                                Visibility="{Binding IsChatBusy, Converter={StaticResource Visible}}" />
                                        <Button Content="Retry" Command="{Binding RetryChatCommand}" ToolTip="Send the message that didn't go through again"
                                                Visibility="{Binding CanRetry, Converter={StaticResource Visible}}" />
                                    </StackPanel>
                                </Grid>
                                <DockPanel Margin="2,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="New chat" Command="{Binding NewChatCommand}" Padding="10,3"
                                            ToolTip="Start over: Claude forgets the earlier messages" />
                                    <TextBlock Text="{Binding UsageText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center"
                                               ToolTip="An estimate from token counts. The Anthropic Console has the real bill." />
                                </DockPanel>
                                <Border x:Name="DropZone" BorderBrush="{StaticResource Border}" BorderThickness="1" CornerRadius="6" Padding="8,4" Margin="0,6,0,0"
                                        Background="{StaticResource Panel}">
                                    <DockPanel>
                                        <Button DockPanel.Dock="Right" Content="Add receipt…" Command="{Binding PickReceiptCommand}" Padding="10,2" MinHeight="28" FontSize="13"
                                                ToolTip="Pick a receipt or invoice photo or PDF" />
                                        <Button DockPanel.Dock="Right" Content="Show receipt" Command="{Binding ToggleReceiptCommand}" Padding="10,2" MinHeight="28" FontSize="13"
                                                Visibility="{Binding CanShowReceipt, Converter={StaticResource Visible}}" Margin="0,0,6,0" />
                                        <TextBlock x:Name="DropText" Text="Drop a receipt photo or PDF here, or paste it (Ctrl+V)" TextWrapping="Wrap"
                                                   Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                    </DockPanel>
                                </Border>
                            </StackPanel>
                            <ScrollViewer x:Name="FeedScroll" VerticalScrollBarVisibility="Auto">
                                <ItemsControl ItemsSource="{Binding Feed}" ItemTemplate="{StaticResource FeedItemTemplate}" />
                            </ScrollViewer>
                        </DockPanel>
                    </Border>

                    <Grid Grid.Column="1">
                        <Grid.RowDefinitions>
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="Auto" />
                            <RowDefinition Height="{Binding ReceiptRowHeight}" />
                            <RowDefinition Height="*" />
                        </Grid.RowDefinitions>

                        <!-- ITEM CARD (hidden while the receipt table is shown) -->
                        <Border Style="{StaticResource Card}" Visibility="{Binding ShowItemArea, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="ITEM" Style="{StaticResource SectionTitle}" />
                                    <Button DockPanel.Dock="Right" Content="Change…" Padding="10,2" MinHeight="26" FontSize="13"
                                            Command="{Binding StartEditCommand}" HorizontalAlignment="Right"
                                            Visibility="{Binding CurrentItem, Converter={StaticResource Visible}}"
                                            ToolTip="Add a change for this item to the pending list" />
                                    <ProgressBar IsIndeterminate="True" Width="80" Height="6" HorizontalAlignment="Right"
                                                 Visibility="{Binding IsBusy, Converter={StaticResource Visible}}" />
                                </DockPanel>
                                <TextBlock Text="Nothing scanned yet." Foreground="{StaticResource Muted}" FontSize="16"
                                           Visibility="{Binding CurrentItem, Converter={StaticResource Hidden}}" />
                                <StackPanel DataContext="{Binding CurrentItem}"
                                            Visibility="{Binding DataContext.CurrentItem, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                    <StackPanel Orientation="Horizontal">
                                        <TextBlock Text="{Binding Description}" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
                                        <Border Background="{StaticResource Danger}" CornerRadius="4" Padding="6,1" Margin="10,0,0,0"
                                                VerticalAlignment="Center" Visibility="{Binding IsInactive, Converter={StaticResource Visible}}">
                                            <TextBlock Text="INACTIVE" Foreground="White" FontWeight="Bold" FontSize="12" />
                                        </Border>
                                    </StackPanel>
                                    <TextBlock Text="{Binding UpcText, StringFormat=UPC {0}}" Foreground="{StaticResource Muted}" Margin="0,2,0,8" />
                                    <TextBlock Text="{Binding PriceText}" FontSize="30" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,0,8"
                                               Visibility="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hidden}}" />
                                    <Grid Visibility="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Hidden}}">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="Auto" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <Grid.RowDefinitions>
                                            <RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition />
                                        </Grid.RowDefinitions>
                                        <TextBlock Grid.Row="0" Grid.Column="0" Text="Case cost" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="1" Text="{Binding CaseCostText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="0" Grid.Column="2" Text="Unit cost" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="0" Grid.Column="3" Text="{Binding UnitCostText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="1" Grid.Column="0" Text="Case size" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="1" Text="{Binding PackText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="1" Grid.Column="2" Text="GM%" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="1" Grid.Column="3" Text="{Binding GmText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="2" Grid.Column="0" Text="Deposit" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="1" Text="{Binding DepositText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="2" Grid.Column="2" Text="Fee/Levy" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="2" Grid.Column="3" Text="{Binding LevyText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="3" Grid.Column="0" Text="On hand" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="3" Grid.Column="1" Text="{Binding OnHandText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="3" Grid.Column="2" Text="Min / Max" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="3" Grid.Column="3" Text="{Binding MinMaxText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="4" Grid.Column="0" Text="Sold" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="4" Grid.Column="1" Text="{Binding SoldText}" Style="{StaticResource FieldValue}" />
                                        <TextBlock Grid.Row="4" Grid.Column="2" Text="Updated" Style="{StaticResource FieldLabel}" />
                                        <TextBlock Grid.Row="4" Grid.Column="3" Text="{Binding LastUpdatedText}" Style="{StaticResource FieldValue}" />
                                    </Grid>
                                    <TextBlock Text="{Binding Note}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,8,0,0"
                                               Visibility="{Binding Note, Converter={StaticResource Visible}}" />
                                    <TextBlock Text="{Binding CaseSizeWarning}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,4,0,0"
                                               Visibility="{Binding CaseSizeWarning, Converter={StaticResource Visible}}" />
                                </StackPanel>

                                <!-- Change this item (inline edit -> pending changes) -->
                                <Border DataContext="{Binding Edit}" Margin="0,10,0,0" Padding="10" CornerRadius="6"
                                        Background="{StaticResource InputBg}" BorderBrush="{StaticResource Accent}" BorderThickness="1"
                                        Visibility="{Binding DataContext.Edit, RelativeSource={RelativeSource AncestorType=Window}, Converter={StaticResource Visible}}">
                                    <StackPanel>
                                        <TextBlock Text="CHANGE THIS ITEM" Style="{StaticResource SectionTitle}" />
                                        <Grid>
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" /><ColumnDefinition Width="*" />
                                            </Grid.ColumnDefinitions>
                                            <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                            <TextBlock Text="Price $" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="1" Text="{Binding Price, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,10,3" />
                                            <TextBlock Grid.Column="2" Text="For" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Column="3" Text="{Binding For, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                            <TextBlock Grid.Row="1" Text="Case cost $" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="1" Text="{Binding CaseCost, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,10,3" />
                                            <TextBlock Grid.Row="1" Grid.Column="2" Text="On hand" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="1" Grid.Column="3" Text="{Binding OnHand, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                            <TextBlock Grid.Row="2" Text="Deposit code" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="1" Text="{Binding Deposit, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,10,3" />
                                            <TextBlock Grid.Row="2" Grid.Column="2" Text="Fee/levy" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="2" Grid.Column="3" Text="{Binding Levy, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                            <TextBlock Grid.Row="3" Text="Min" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="1" Text="{Binding Min, UpdateSourceTrigger=PropertyChanged}" Margin="0,3,10,3" />
                                            <TextBlock Grid.Row="3" Grid.Column="2" Text="Max" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="3" Grid.Column="3" Text="{Binding Max, UpdateSourceTrigger=PropertyChanged}" Margin="0,3" />
                                            <TextBlock Grid.Row="4" Text="Why" Style="{StaticResource FieldLabel}" />
                                            <TextBox Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="3" Text="{Binding Reason, UpdateSourceTrigger=PropertyChanged}" Margin="0,3"
                                                     ToolTip="Optional, e.g. new cost from the Pepsi invoice" />
                                        </Grid>
                                        <TextBlock Text="{Binding Message}" TextWrapping="Wrap" Foreground="{StaticResource Warning}" Margin="0,4,0,0"
                                                   Visibility="{Binding Message, Converter={StaticResource Visible}}" />
                                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,6,0,0">
                                            <Button Content="{Binding PriceFromCostLabel}" ContentStringFormat="Price from cost ({0})"
                                                    Command="{Binding DataContext.PriceFromCostCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Add to changes" Style="{StaticResource PrimaryButton}"
                                                    Command="{Binding DataContext.StageEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                            <Button Content="Cancel"
                                                    Command="{Binding DataContext.CancelEditCommand, RelativeSource={RelativeSource AncestorType=Window}}" />
                                        </StackPanel>
                                    </StackPanel>
                                </Border>
                            </StackPanel>
                        </Border>

                        <!-- SCAN LIST -->
                        <Border Grid.Row="1" Style="{StaticResource Card}" Padding="10"
                                Visibility="{Binding HasScanList, Converter={StaticResource Visible}}">
                            <StackPanel>
                                <DockPanel>
                                    <TextBlock Text="{Binding ScanList.Count, StringFormat=SCANNED ({0})}" Style="{StaticResource SectionTitle}" />
                                    <Button Content="Clear" HorizontalAlignment="Right" Padding="8,2" MinHeight="26" FontSize="13"
                                            Command="{Binding ClearScanListCommand}" />
                                </DockPanel>
                                <ItemsControl ItemsSource="{Binding ScanList}" MaxHeight="140">
                                    <ItemsControl.Template>
                                        <ControlTemplate><ScrollViewer VerticalScrollBarVisibility="Auto"><ItemsPresenter /></ScrollViewer></ControlTemplate>
                                    </ItemsControl.Template>
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate DataType="{x:Type vm:ScannedEntry}">
                                            <DockPanel Margin="0,1">
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding PriceText}" FontWeight="SemiBold" />
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding CountText}" FontWeight="Bold" Foreground="{StaticResource AccentText}" Margin="0,0,14,0" />
                                                <TextBlock Text="{Binding Description}" TextTrimming="CharacterEllipsis" />
                                            </DockPanel>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </StackPanel>
                        </Border>

                        <!-- RECEIPT TABLE (spec F5.7): line -> matched item -> cost -> proposed price -->
                        <Border Grid.Row="2" Style="{StaticResource Card}" Visibility="{Binding ShowReceipt, Converter={StaticResource Visible}}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Top">
                                        <Button Content="Hide" Command="{Binding ToggleReceiptCommand}" Padding="8,2" MinHeight="26" FontSize="13"
                                                ToolTip="Show the item card again (the receipt stays open)" />
                                        <Button Content="Finish receipt" Command="{Binding FinishReceiptCommand}" Padding="8,2" MinHeight="26" FontSize="13"
                                                ToolTip="Close the receipt and move it to Receipts\Done" />
                                    </StackPanel>
                                    <StackPanel>
                                        <TextBlock Text="{Binding ReceiptTitle}" Style="{StaticResource SectionTitle}" TextTrimming="CharacterEllipsis" />
                                        <TextBlock Text="{Binding ReceiptSummary}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                    </StackPanel>
                                </DockPanel>
                                <DockPanel DockPanel.Dock="Bottom" Margin="0,6,0,0">
                                    <Button DockPanel.Dock="Right" Content="Add ticked to pending" Style="{StaticResource PrimaryButton}" Command="{Binding StageReceiptCommand}"
                                            ToolTipService.ShowOnDisabled="True"
                                            ToolTip="Puts the new case cost (and the new price, where there is one) of each ticked line in Pending changes. Nothing is saved." />
                                    <TextBlock Text="Costs leave out deposits and eco fees. New case costs are only used for the lines you tick." FontSize="12"
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center" />
                                </DockPanel>
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding ReceiptLines}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:ReceiptLineViewModel}">
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,6">
                                                    <DockPanel>
                                                        <CheckBox DockPanel.Dock="Left" IsChecked="{Binding IsChecked}" IsEnabled="{Binding CanCheck}"
                                                                  VerticalAlignment="Top" Margin="0,2,8,0" ToolTip="Tick to add this line's new cost/price to Pending changes" />
                                                        <StackPanel>
                                                            <DockPanel>
                                                                <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0,0,0" VerticalAlignment="Top"
                                                                        Background="{Binding StatusLevel, Converter={StaticResource StatusBrush}}">
                                                                    <TextBlock Text="{Binding StatusText}" Foreground="#16181B" FontWeight="SemiBold" FontSize="12" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ReceiptText}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                            </DockPanel>
                                                            <TextBlock Text="{Binding ItemText}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                       Visibility="{Binding ItemText, Converter={StaticResource Visible}}" />
                                                            <TextBlock Text="{Binding MatchedByText}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                       Visibility="{Binding MatchedByText, Converter={StaticResource Visible}}" />
                                                            <TextBlock Text="{Binding CostText}" FontSize="15" Foreground="{StaticResource AccentText}" TextWrapping="Wrap"
                                                                       ToolTip="{Binding CostMath}" Visibility="{Binding CostText, Converter={StaticResource Visible}}" />
                                                            <TextBlock Text="{Binding CostMath}" FontSize="11" Foreground="{StaticResource Muted}"
                                                                       Visibility="{Binding CostMath, Converter={StaticResource Visible}}" />
                                                            <TextBlock x:Name="Price" Text="{Binding PriceText}" FontSize="14" TextWrapping="Wrap"
                                                                       Visibility="{Binding PriceText, Converter={StaticResource Visible}}" />
                                                            <TextBlock Text="{Binding WarningsText}" FontSize="13" Foreground="{StaticResource Warning}" TextWrapping="Wrap"
                                                                       Visibility="{Binding WarningsText, Converter={StaticResource Visible}}" />
                                                            <TextBlock Text="{Binding NoteText}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap"
                                                                       Visibility="{Binding NoteText, Converter={StaticResource Visible}}" />
                                                            <ItemsControl ItemsSource="{Binding Candidates}" Margin="0,4,0,0"
                                                                          Visibility="{Binding HasCandidates, Converter={StaticResource Visible}}">
                                                                <ItemsControl.ItemTemplate>
                                                                    <DataTemplate DataType="{x:Type vm:ReceiptCandidateViewModel}">
                                                                        <Button Style="{StaticResource ChoiceButton}" Padding="8,3" ToolTip="This is the item on the receipt"
                                                                                Command="{Binding DataContext.ChooseReceiptCandidateCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                                CommandParameter="{Binding}">
                                                                            <StackPanel>
                                                                                <TextBlock Text="{Binding Label}" FontSize="14" />
                                                                                <TextBlock Text="{Binding Detail}" FontSize="11" Foreground="{StaticResource Muted}" />
                                                                            </StackPanel>
                                                                        </Button>
                                                                    </DataTemplate>
                                                                </ItemsControl.ItemTemplate>
                                                            </ItemsControl>
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding HasProposedPrice}" Value="True">
                                                        <Setter TargetName="Price" Property="FontWeight" Value="SemiBold" />
                                                        <Setter TargetName="Price" Property="Foreground" Value="{StaticResource AccentText}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </DockPanel>
                        </Border>

                        <!-- PENDING CHANGES -->
                        <Border Grid.Row="3" Style="{StaticResource Card}">
                            <DockPanel>
                                <DockPanel DockPanel.Dock="Top">
                                    <TextBlock Text="{Binding PendingRows.Count, StringFormat=PENDING CHANGES ({0})}" Style="{StaticResource SectionTitle}" />
                                    <TextBlock Text="{Binding ExecutorName, StringFormat=Dry runs: {0}}" FontSize="12" Foreground="{StaticResource Muted}"
                                               HorizontalAlignment="Right" VerticalAlignment="Top" />
                                </DockPanel>
                                <StackPanel DockPanel.Dock="Bottom">
                                    <DockPanel Margin="0,6,0,6" Visibility="{Binding DryRunSummary, Converter={StaticResource Visible}}">
                                        <Ellipse Style="{StaticResource StatusDot}" Fill="{Binding DryRunLevel, Converter={StaticResource StatusBrush}}" VerticalAlignment="Top" Margin="0,5,6,0" />
                                        <TextBlock Text="{Binding DryRunSummary}" TextWrapping="Wrap" />
                                    </DockPanel>
                                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                        <Button Content="Dry run" Style="{StaticResource PrimaryButton}" Command="{Binding DryRunCommand}"
                                                ToolTip="Types each change into eStream, then exits WITHOUT saving, to check it works" />
                                        <Button Content="SAVE" Style="{StaticResource SaveButton}" Command="{Binding SaveCommand}"
                                                ToolTipService.ShowOnDisabled="True" ToolTip="{Binding SaveToolTip}" />
                                        <Button Content="Clear" Command="{Binding ClearPendingCommand}" />
                                    </StackPanel>
                                </StackPanel>
                                <Grid>
                                    <TextBlock Text="No changes yet. Ask Claude, or press Change on the item card. Changes show here as Now → New, ready for a dry run."
                                               Foreground="{StaticResource Muted}" TextWrapping="Wrap" VerticalAlignment="Center"
                                               HorizontalAlignment="Center" TextAlignment="Center" Margin="20"
                                               Visibility="{Binding HasPending, Converter={StaticResource Hidden}}" />
                                    <ScrollViewer VerticalScrollBarVisibility="Auto" Visibility="{Binding HasPending, Converter={StaticResource Visible}}">
                                        <ItemsControl ItemsSource="{Binding PendingRows}">
                                            <ItemsControl.ItemTemplate>
                                                <DataTemplate DataType="{x:Type vm:PendingRowViewModel}">
                                                    <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,6">
                                                        <DockPanel>
                                                            <Button DockPanel.Dock="Right" Content="Edit" Padding="8,2" MinHeight="26" FontSize="13" VerticalAlignment="Top"
                                                                    ToolTip="Change the New values (opens the item's change form)" Margin="0,0,4,0"
                                                                    Command="{Binding DataContext.EditPendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button DockPanel.Dock="Right" Content="×" Padding="8,2" MinHeight="26" FontSize="13" VerticalAlignment="Top"
                                                                    ToolTip="Remove this row"
                                                                    Command="{Binding DataContext.RemovePendingCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <StackPanel>
                                                                <DockPanel>
                                                                    <Border DockPanel.Dock="Right" CornerRadius="4" Padding="6,1" Margin="8,0" VerticalAlignment="Top"
                                                                            Background="{Binding StatusLevel, Converter={StaticResource StatusBrush}}">
                                                                        <TextBlock Text="{Binding StatusText}" Foreground="#16181B" FontWeight="SemiBold" FontSize="12" />
                                                                    </Border>
                                                                    <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                </DockPanel>
                                                                <TextBlock Text="{Binding UpcText, StringFormat=UPC {0}}" FontSize="12" Foreground="{StaticResource Muted}" />
                                                                <TextBlock Text="{Binding ChangesText}" FontSize="18" Foreground="{StaticResource AccentText}" Margin="0,2,0,0" />
                                                                <TextBlock x:Name="Gm" Text="{Binding GmText}" FontSize="13" Foreground="{StaticResource Muted}"
                                                                           Visibility="{Binding GmText, Converter={StaticResource Visible}}" />
                                                                <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                                                <TextBlock Text="{Binding ReasonText}" FontSize="12" TextWrapping="Wrap" Foreground="{StaticResource Muted}"
                                                                           Visibility="{Binding ReasonText, Converter={StaticResource Visible}}" />
                                                                <TextBlock Text="Large change allowed by the owner" FontSize="12" Foreground="{StaticResource Warning}"
                                                                           Visibility="{Binding IsForced, Converter={StaticResource Visible}}" />
                                                                <Button Content="Allow large change…" HorizontalAlignment="Left" Margin="0,4,0,0" Padding="8,2" MinHeight="26" FontSize="13"
                                                                        Visibility="{Binding CanAllowLargeChange, Converter={StaticResource Visible}}"
                                                                        Command="{Binding DataContext.AllowLargeChangeCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                        CommandParameter="{Binding}" />
                                                            </StackPanel>
                                                        </DockPanel>
                                                    </Border>
                                                    <DataTemplate.Triggers>
                                                        <DataTrigger Binding="{Binding GmDrops}" Value="True">
                                                            <Setter TargetName="Gm" Property="Foreground" Value="{StaticResource Warning}" />
                                                        </DataTrigger>
                                                    </DataTemplate.Triggers>
                                                </DataTemplate>
                                            </ItemsControl.ItemTemplate>
                                        </ItemsControl>
                                    </ScrollViewer>
                                </Grid>
                            </DockPanel>
                        </Border>
                    </Grid>
                </Grid>
            </TabItem>

            <!-- ===================== HISTORY ===================== -->
            <TabItem Header="  History  ">
                <Grid Margin="6" DataContext="{Binding History}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="5*" />
                        <ColumnDefinition Width="6*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="PAST RUNS" Style="{StaticResource SectionTitle}" />
                            <DockPanel DockPanel.Dock="Top" Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="Refresh" Command="{Binding RefreshCommand}" Padding="10,3" />
                                <CheckBox DockPanel.Dock="Right" Content="Dry runs" IsChecked="{Binding ShowDryRuns}" VerticalAlignment="Center"
                                          Foreground="{StaticResource Text}" Margin="8,0" />
                                <Grid>
                                    <TextBox x:Name="HistoryFilter" Text="{Binding Filter, UpdateSourceTrigger=PropertyChanged}" MinHeight="34"
                                             ToolTip="Filter by UPC, item name, status or text" />
                                    <TextBlock Text="Filter: UPC, name, status…" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                               Foreground="{StaticResource Placeholder}"
                                               Visibility="{Binding Text, ElementName=HistoryFilter, Converter={StaticResource Hidden}}" />
                                </Grid>
                            </DockPanel>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,8">
                                <ComboBox ItemsSource="{Binding Periods}" SelectedItem="{Binding Period}" DisplayMemberPath="Label" MinWidth="150" Margin="0,0,8,0"
                                          ToolTip="Show runs from this time" />
                                <ComboBox ItemsSource="{Binding Statuses}" SelectedItem="{Binding Status}" DisplayMemberPath="Label" MinWidth="170"
                                          ToolTip="Show only runs where everything went through, or only runs with a problem" />
                            </StackPanel>
                            <TextBlock DockPanel.Dock="Bottom" Text="{Binding CountText}" FontSize="12" Foreground="{StaticResource Muted}" Margin="2,6,0,0" />
                            <ListBox ItemsSource="{Binding Runs}" SelectedItem="{Binding Selected}" Background="Transparent" BorderThickness="0"
                                     ScrollViewer.HorizontalScrollBarVisibility="Disabled">
                                <ListBox.ItemContainerStyle>
                                    <Style TargetType="ListBoxItem">
                                        <Setter Property="Foreground" Value="{StaticResource Text}" />
                                        <Setter Property="Padding" Value="8,6" />
                                        <Setter Property="Template">
                                            <Setter.Value>
                                                <ControlTemplate TargetType="ListBoxItem">
                                                    <Border x:Name="Bd" Background="Transparent" CornerRadius="6" Padding="{TemplateBinding Padding}" Margin="0,1">
                                                        <ContentPresenter />
                                                    </Border>
                                                    <ControlTemplate.Triggers>
                                                        <Trigger Property="IsMouseOver" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource ButtonBg}" />
                                                        </Trigger>
                                                        <Trigger Property="IsSelected" Value="True">
                                                            <Setter TargetName="Bd" Property="Background" Value="{StaticResource OwnerBubble}" />
                                                        </Trigger>
                                                    </ControlTemplate.Triggers>
                                                </ControlTemplate>
                                            </Setter.Value>
                                        </Setter>
                                    </Style>
                                </ListBox.ItemContainerStyle>
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <DockPanel>
                                                <TextBlock DockPanel.Dock="Right" Text="{Binding Time, StringFormat={}{0:MMM d, h:mm tt}}" Foreground="{StaticResource Muted}" FontSize="13" />
                                                <TextBlock x:Name="Kind" Text="{Binding Kind}" FontWeight="SemiBold" />
                                            </DockPanel>
                                            <TextBlock Text="{Binding Summary}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                        </StackPanel>
                                        <DataTemplate.Triggers>
                                            <DataTrigger Binding="{Binding IsDryRun}" Value="False">
                                                <Setter TargetName="Kind" Property="Foreground" Value="{StaticResource AccentText}" />
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsInterrupted}" Value="True">
                                                <Setter TargetName="Kind" Property="Foreground" Value="{StaticResource Warning}" />
                                            </DataTrigger>
                                        </DataTemplate.Triggers>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                        </DockPanel>
                    </Border>
                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel DataContext="{Binding Selected}">
                            <StackPanel DockPanel.Dock="Top">
                                <TextBlock Text="RUN DETAILS" Style="{StaticResource SectionTitle}" />
                                <TextBlock Text="{Binding Name}" FontSize="16" FontWeight="SemiBold" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Path}" FontSize="12" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                <TextBlock Text="{Binding Problem}" Foreground="{StaticResource Warning}" TextWrapping="Wrap" Margin="0,6,0,0"
                                           Visibility="{Binding Problem, Converter={StaticResource Visible}}" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <TextBlock Text="LOG LINES" Style="{StaticResource SectionTitle}" />
                                <TextBox Text="{Binding DataContext.History.LogExcerpt, RelativeSource={RelativeSource AncestorType=Window}, Mode=OneWay}"
                                         IsReadOnly="True" FontSize="12" Height="120" TextWrapping="Wrap" VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <ScrollViewer VerticalScrollBarVisibility="Auto" Margin="0,10,0,0">
                                <ItemsControl ItemsSource="{Binding Rows}">
                                    <ItemsControl.ItemTemplate>
                                        <DataTemplate>
                                            <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,6">
                                                <StackPanel>
                                                    <DockPanel>
                                                        <TextBlock DockPanel.Dock="Right" Text="{Binding Status}" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" />
                                                        <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                    </DockPanel>
                                                    <TextBlock Text="{Binding Upc, StringFormat=UPC {0}}" FontSize="12" Foreground="{StaticResource Muted}" />
                                                    <TextBlock Text="{Binding Changes}" TextWrapping="Wrap" />
                                                    <TextBlock Text="{Binding Message}" FontSize="13" TextWrapping="Wrap" Foreground="{StaticResource Muted}" />
                                                </StackPanel>
                                            </Border>
                                        </DataTemplate>
                                    </ItemsControl.ItemTemplate>
                                </ItemsControl>
                            </ScrollViewer>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== STOCK COUNTS ===================== -->
            <TabItem Header="  Stock counts  ">
                <Grid Margin="6" DataContext="{Binding Counts}">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="6*" />
                        <ColumnDefinition Width="5*" />
                    </Grid.ColumnDefinitions>
                    <Border Style="{StaticResource Card}">
                        <DockPanel>
                            <DockPanel DockPanel.Dock="Top">
                                <TextBlock DockPanel.Dock="Right" Text="TEST MODE: mock engine" Foreground="{StaticResource Warning}" FontSize="12" FontWeight="SemiBold"
                                           Visibility="{Binding IsMock, Converter={StaticResource Visible}}" />
                                <TextBlock Text="COUNT" Style="{StaticResource SectionTitle}" />
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,6">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="110" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <Grid>
                                    <TextBox x:Name="CountUpcBox" Text="{Binding UpcText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" FontSize="16" />
                                    <TextBlock Text="UPC (scan or type)" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Placeholder}"
                                               Visibility="{Binding Text, ElementName=CountUpcBox, Converter={StaticResource Hidden}}" />
                                </Grid>
                                <Grid Grid.Column="1" Margin="8,0">
                                    <TextBox x:Name="CountBox" Text="{Binding CountText, UpdateSourceTrigger=PropertyChanged}" MinHeight="36" FontSize="16" />
                                    <TextBlock Text="Count" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False" Foreground="{StaticResource Placeholder}"
                                               Visibility="{Binding Text, ElementName=CountBox, Converter={StaticResource Hidden}}" />
                                </Grid>
                                <Button Grid.Column="2" Content="Add" Command="{Binding AddCountCommand}" Style="{StaticResource PrimaryButton}" MinWidth="80" />
                            </Grid>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding ItemText}" Foreground="{StaticResource AccentText}" TextWrapping="Wrap" Margin="2,0,0,4" />
                            <DockPanel DockPanel.Dock="Top" Margin="0,2,0,8">
                                <Button DockPanel.Dock="Right" Content="Import CSV…" Command="{Binding ImportCsvCommand}" Padding="10,3"
                                        ToolTip="A file with UPC,Count lines (header optional)." />
                                <CheckBox Content="Add to an earlier count of the same item" IsChecked="{Binding AddToExisting}" VerticalAlignment="Center"
                                          Foreground="{StaticResource Text}" ToolTip="On: counting the same item in two places adds up. Off: the new count replaces it." />
                            </DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="{Binding Status}" TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="2,0,0,8"
                                       Visibility="{Binding Status, Converter={StaticResource Visible}}" />
                            <DockPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                <Button DockPanel.Dock="Right" Content="Clear" Command="{Binding ClearCommand}" />
                                <Button DockPanel.Dock="Right" Content="Refresh on-hand" Command="{Binding RefreshSystemCommand}" Margin="0,0,8,0"
                                        ToolTip="Reload system on-hand from eStream (it changes as items sell)." />
                                <TextBlock Text="{Binding TotalsText}" VerticalAlignment="Center" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                            </DockPanel>
                            <Grid DockPanel.Dock="Top" Margin="2,0,40,4">
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" />
                                </Grid.ColumnDefinitions>
                                <TextBlock Text="ITEM" FontSize="12" Foreground="{StaticResource Muted}" />
                                <TextBlock Grid.Column="1" Text="COUNTED" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" />
                                <TextBlock Grid.Column="2" Text="SYSTEM" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" />
                                <TextBlock Grid.Column="3" Text="OVER/SHORT" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" />
                            </Grid>
                            <Grid>
                                <TextBlock Text="No counts yet. Open this tab and scan: each scan picks the item, then type the count and press Enter."
                                           Foreground="{StaticResource Muted}" TextWrapping="Wrap" Margin="2,8"
                                           Visibility="{Binding HasRows, Converter={StaticResource Hidden}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Rows}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:CountRowViewModel}">
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,5">
                                                    <DockPanel>
                                                        <Button DockPanel.Dock="Right" Content="×" Padding="8,2" MinHeight="26" FontSize="13" Margin="10,0,0,0"
                                                                ToolTip="Remove this count"
                                                                Command="{Binding DataContext.Counts.RemoveRowCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                CommandParameter="{Binding}" />
                                                        <Grid>
                                                            <Grid.ColumnDefinitions>
                                                                <ColumnDefinition Width="*" /><ColumnDefinition Width="80" /><ColumnDefinition Width="80" /><ColumnDefinition Width="90" />
                                                            </Grid.ColumnDefinitions>
                                                            <StackPanel>
                                                                <TextBlock Text="{Binding Description}" FontWeight="SemiBold" TextTrimming="CharacterEllipsis" />
                                                                <TextBlock Text="{Binding Upc, StringFormat=UPC {0}}" FontSize="12" Foreground="{StaticResource Muted}" />
                                                            </StackPanel>
                                                            <TextBlock Grid.Column="1" Text="{Binding CountText}" FontSize="18" TextAlignment="Right" VerticalAlignment="Center" />
                                                            <TextBlock Grid.Column="2" Text="{Binding SystemText}" FontSize="16" Foreground="{StaticResource Muted}" TextAlignment="Right" VerticalAlignment="Center" />
                                                            <StackPanel Grid.Column="3" VerticalAlignment="Center">
                                                                <Border HorizontalAlignment="Right" CornerRadius="4" Padding="6,1"
                                                                        Background="{Binding Level, Converter={StaticResource StatusBrush}}">
                                                                    <TextBlock Text="{Binding OverShortText}" Foreground="#16181B" FontWeight="SemiBold" />
                                                                </Border>
                                                                <TextBlock Text="{Binding ValueText}" FontSize="12" Foreground="{StaticResource Muted}" TextAlignment="Right" />
                                                            </StackPanel>
                                                        </Grid>
                                                    </DockPanel>
                                                </Border>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>

                    <Border Grid.Column="1" Style="{StaticResource Card}">
                        <DockPanel>
                            <TextBlock DockPanel.Dock="Top" Text="STOCK SHEETS" Style="{StaticResource SectionTitle}" />
                            <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="13" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                                       Text="1. Check: compares the counts in eStream, changes nothing.  2. Make stock sheet: a new sheet with these counts (uses a sheet number).  3. Post: sets on-hand for good. NO UNDO." />
                            <Grid DockPanel.Dock="Top" Margin="0,0,0,8">
                                <TextBox x:Name="SheetComment" Text="{Binding Comment, UpdateSourceTrigger=PropertyChanged}" MinHeight="34" MaxLength="60" />
                                <TextBlock Text="Sheet comment, e.g. Chips aisle" Margin="10,0" VerticalAlignment="Center" IsHitTestVisible="False"
                                           Foreground="{StaticResource Placeholder}"
                                           Visibility="{Binding Text, ElementName=SheetComment, Converter={StaticResource Hidden}}" />
                            </Grid>
                            <StackPanel DockPanel.Dock="Top" Orientation="Horizontal" Margin="0,0,0,10">
                                <Button Content="Check" Command="{Binding CheckCommand}" Style="{StaticResource PrimaryButton}" MinWidth="90" Margin="0,0,8,0" />
                                <Button Content="Make stock sheet…" Command="{Binding CreateSheetCommand}" MinWidth="150" />
                            </StackPanel>
                            <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0" Visibility="{Binding CheckOutput, Converter={StaticResource Visible}}">
                                <TextBlock Text="ENGINE OUTPUT" Style="{StaticResource SectionTitle}" />
                                <TextBox Text="{Binding CheckOutput, Mode=OneWay}" IsReadOnly="True" FontSize="12" Height="130" TextWrapping="Wrap"
                                         VerticalScrollBarVisibility="Auto" />
                            </StackPanel>
                            <Grid>
                                <TextBlock Text="Sheets made by this app will be listed here." Foreground="{StaticResource Muted}" Margin="2,4"
                                           Visibility="{Binding HasSheets, Converter={StaticResource Hidden}}" />
                                <ScrollViewer VerticalScrollBarVisibility="Auto">
                                    <ItemsControl ItemsSource="{Binding Sheets}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate DataType="{x:Type vm:SheetViewModel}">
                                                <Border BorderBrush="{StaticResource Border}" BorderThickness="0,0,0,1" Padding="2,6">
                                                    <DockPanel>
                                                        <StackPanel DockPanel.Dock="Right" Orientation="Horizontal" VerticalAlignment="Center">
                                                            <Button Content="Enter number…" Padding="10,3" Margin="0,0,6,0"
                                                                    Visibility="{Binding NeedsNumber, Converter={StaticResource Visible}}"
                                                                    Command="{Binding DataContext.Counts.EnterNumberCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                            <Button Content="Post…" Style="{StaticResource SaveButton}" MinWidth="80" Padding="10,3"
                                                                    IsEnabled="{Binding CanPost}" ToolTipService.ShowOnDisabled="True" ToolTip="{Binding PostToolTip}"
                                                                    Visibility="{Binding IsPosted, Converter={StaticResource Hidden}}"
                                                                    Command="{Binding DataContext.Counts.PostCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                                    CommandParameter="{Binding}" />
                                                        </StackPanel>
                                                        <StackPanel>
                                                            <TextBlock x:Name="SheetTitle" Text="{Binding Title}" FontWeight="SemiBold" FontSize="16" />
                                                            <TextBlock Text="{Binding Detail}" FontSize="13" Foreground="{StaticResource Muted}" TextWrapping="Wrap" />
                                                        </StackPanel>
                                                    </DockPanel>
                                                </Border>
                                                <DataTemplate.Triggers>
                                                    <DataTrigger Binding="{Binding IsPosted}" Value="True">
                                                        <Setter TargetName="SheetTitle" Property="Foreground" Value="{StaticResource Muted}" />
                                                    </DataTrigger>
                                                </DataTemplate.Triggers>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </ScrollViewer>
                            </Grid>
                        </DockPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- ===================== SETTINGS ===================== -->
            <TabItem Header="  Settings  ">
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <StackPanel Margin="12" MaxWidth="820" HorizontalAlignment="Left" DataContext="{Binding Settings}">
                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="CLAUDE" Style="{StaticResource SectionTitle}" />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,0,0,8"
                                           Text="Needs an Anthropic Console API key (billed per use, separate from any Claude subscription). The key is encrypted for this Windows user only." />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="160" /><ColumnDefinition Width="*" /><ColumnDefinition Width="Auto" />
                                    </Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Saved key" Style="{StaticResource FieldLabel}" />
                                    <TextBlock Grid.Column="1" Text="{Binding ApiKeyDisplay}" Style="{StaticResource FieldValue}" />
                                    <Button Grid.Column="2" Content="Remove key" Command="{Binding ClearApiKeyCommand}"
                                            IsEnabled="{Binding HasApiKey}" />
                                    <TextBlock Grid.Row="1" Text="New key" Style="{StaticResource FieldLabel}" />
                                    <PasswordBox Grid.Row="1" Grid.Column="1" x:Name="ApiKeyBox" Margin="0,4" Padding="6,4" />
                                    <Button Grid.Row="1" Grid.Column="2" Content="Save key" Click="SaveApiKey_Click" />
                                    <TextBlock Grid.Row="2" Text="Model" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="2" Grid.Column="1" IsEditable="True" Margin="0,4"
                                              ItemsSource="{Binding Models}" Text="{Binding Model, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Grid.Row="3" Text="Effort" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="3" Grid.Column="1" Margin="0,4"
                                              ItemsSource="{Binding Efforts}" SelectedItem="{Binding Effort}"
                                              ToolTip="low = fastest and cheapest (fine for lookups); high = more careful on hard questions" />
                                    <Button Grid.Row="4" Grid.Column="0" Content="Test connection" Command="{Binding TestConnectionCommand}"
                                            IsEnabled="{Binding HasApiKey}" HorizontalAlignment="Left" Margin="0,6,0,0" />
                                    <TextBlock Grid.Row="4" Grid.Column="1" Grid.ColumnSpan="2" Text="{Binding TestResult}" TextWrapping="Wrap"
                                               Style="{StaticResource FieldValue}" Margin="10,6,0,0" />
                                    <TextBlock Grid.Row="5" Text="Long chat" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding LongChatTurns}"
                                             ToolTip="After this many messages in one chat, the app suggests New chat (long chats cost more). 0 = never." />
                                    <CheckBox Grid.Row="6" Grid.Column="1" Margin="0,6" IsChecked="{Binding DebugLogging}"
                                              Content="Debug log: also write chat messages to the app log" />
                                </Grid>
                                <TextBlock Text="{Binding PricesLabel}" Style="{StaticResource FieldLabel}" Margin="0,10,0,2" />
                                <StackPanel Orientation="Horizontal">
                                    <TextBlock Text="Input $" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox Width="80" Margin="0,4,16,4" Text="{Binding PriceIn}" />
                                    <TextBlock Text="Output $" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox Width="80" Margin="0,4,16,4" Text="{Binding PriceOut}" />
                                    <TextBlock Text="Cache read $" Style="{StaticResource FieldLabel}" Margin="0,0,6,0" />
                                    <TextBox Width="80" Margin="0,4" Text="{Binding PriceCacheRead}"
                                             ToolTip="Used only for the cost estimate. Check the Anthropic pricing page if prices change." />
                                </StackPanel>
                                <TextBlock Text="{Binding UsageDetail}" TextWrapping="Wrap" Margin="0,8,0,0" FontSize="13"
                                           ToolTip="An estimate from token counts. The Anthropic Console has the real bill." />
                                <TextBlock TextWrapping="Wrap" Foreground="{StaticResource Muted}" Margin="0,10,0,0" FontSize="13"
                                           Text="If Claude's safety checks decline a request, it is automatically retried on a backup Claude model (server-side fallback). Claude can look things up, fill the pending list and run dry runs; only you can SAVE or post a stock sheet." />
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="PRICING" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Default mode" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding PricingModes}" SelectedItem="{Binding DefaultPricingMode}" />
                                    <TextBlock Grid.Row="1" Text="Default %" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding DefaultMarkupPct}" />
                                    <TextBlock Grid.Row="2" Text="Price endings" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding PriceEndings}"
                                             ToolTip="Cents to round up to, e.g. 29, 49, 79, 99. Leave empty for no rounding." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="ESTREAM" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Data source" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Column="1" Margin="0,4" ItemsSource="{Binding DataSources}" SelectedItem="{Binding DataSource}"
                                              ToolTip="Mock = sample data on the dev PC. Sql = the real eStream database (read-only), on the store PC." />
                                    <TextBlock Grid.Row="1" Text="SQL connection" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding ConnectionString}" FontSize="13"
                                             ToolTip="ApplicationIntent=ReadOnly is always forced on." />
                                    <TextBlock Grid.Row="2" Text="Sample export" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding SampleDataPath}"
                                             ToolTip="Optional sample-items.txt (sqlcmd export) used with the Mock data source." />
                                    <TextBlock Grid.Row="3" Text="Engine folder" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding EngineFolder}"
                                             ToolTip="Folder with Invoke-EsCsv.ps1 and the other eStream scripts." />
                                    <TextBlock Grid.Row="5" Text="Protected sheets" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="5" Grid.Column="1" Margin="0,4" Text="{Binding ProtectedSheets}"
                                             ToolTip="Stock sheet numbers the app must never touch (your own open sheets), e.g. 10001, 10002. Kept on this PC only." />
                                    <TextBlock Grid.Row="6" Text="Protected batches" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="6" Grid.Column="1" Margin="0,4" Text="{Binding ProtectedBatches}"
                                             ToolTip="Pending price batch numbers that aren't the app's. Kept on this PC only." />
                                    <Button Grid.Row="7" Grid.Column="1" Content="Open Power Automate Desktop" Command="{Binding OpenPadFlowCommand}"
                                            HorizontalAlignment="Left" Margin="0,6,0,0"
                                            ToolTip="For running the &quot;Estream&quot; flow by hand. The app itself runs the scripts directly." />
                                    <TextBlock Grid.Row="4" Text="Dry runs with" Style="{StaticResource FieldLabel}" />
                                    <ComboBox Grid.Row="4" Grid.Column="1" Margin="0,4" ItemsSource="{Binding Executors}" SelectedItem="{Binding Executor}"
                                              ToolTip="Mock = simulated, eStream is not touched. PowerShell = the real scripts type into eStream (then Exit without saving)." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <Border Style="{StaticResource Card}">
                            <StackPanel>
                                <TextBlock Text="SCANNER" Style="{StaticResource SectionTitle}" />
                                <Grid>
                                    <Grid.ColumnDefinitions><ColumnDefinition Width="160" /><ColumnDefinition Width="*" /></Grid.ColumnDefinitions>
                                    <Grid.RowDefinitions><RowDefinition /><RowDefinition /><RowDefinition /><RowDefinition /></Grid.RowDefinitions>
                                    <TextBlock Text="Key gap (ms)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Column="1" Margin="0,4" Text="{Binding ScanMaxInterKeyMs}"
                                             ToolTip="Keys closer together than this count as a scanner. Default 40." />
                                    <TextBlock Grid.Row="1" Text="Scan list (sec)" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="1" Grid.Column="1" Margin="0,4" Text="{Binding ScanListWindowSeconds}"
                                             ToolTip="Scans closer together than this build one list. Default 10." />
                                    <TextBlock Grid.Row="2" Text="Min digits" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="2" Grid.Column="1" Margin="0,4" Text="{Binding ScanMinDigits}"
                                             ToolTip="Shortest barcode the scanner sends. Default 6. Applies after a restart." />
                                    <TextBlock Grid.Row="3" Text="Max digits" Style="{StaticResource FieldLabel}" />
                                    <TextBox Grid.Row="3" Grid.Column="1" Margin="0,4" Text="{Binding ScanMaxDigits}"
                                             ToolTip="Longest barcode the scanner sends. Default 14. Applies after a restart." />
                                </Grid>
                            </StackPanel>
                        </Border>

                        <StackPanel Orientation="Horizontal" Margin="6">
                            <Button Content="Save settings" Style="{StaticResource PrimaryButton}" Command="{Binding SaveCommand}" />
                            <Button Content="Refresh item names" Click="RefreshNames_Click" />
                            <TextBlock Text="{Binding DataContext.CacheStatusText, RelativeSource={RelativeSource AncestorType=Window}}"
                                       VerticalAlignment="Center" Foreground="{StaticResource Muted}" Margin="8,0" />
                        </StackPanel>
                        <TextBlock Text="{Binding StatusMessage}" Margin="10,4" FontWeight="SemiBold" TextWrapping="Wrap" />
                        <TextBlock Text="{Binding DataFolder, StringFormat=App files: {0}}" Margin="10,12" Foreground="{StaticResource Muted}" />
                    </StackPanel>
                </ScrollViewer>
            </TabItem>
        </TabControl>
    </DockPanel>

    <!-- S8: while the engine drives eStream, nothing in this window can be used. -->
    <Border Background="#D0181A1D" Visibility="{Binding IsWorking, Converter={StaticResource Visible}}" Focusable="False">
        <Border HorizontalAlignment="Center" VerticalAlignment="Center" Background="{StaticResource CardBg}" CornerRadius="10"
                BorderBrush="{StaticResource Warning}" BorderThickness="2" Padding="36,28" MaxWidth="640">
            <StackPanel>
                <TextBlock Text="Working…" FontSize="28" FontWeight="Bold" Foreground="{StaticResource Warning}" HorizontalAlignment="Center" />
                <TextBlock Text="{Binding WorkingText}" FontSize="20" TextWrapping="Wrap" TextAlignment="Center" Margin="0,12,0,6" />
                <TextBlock Text="{Binding WorkingDetail}" FontSize="14" Foreground="{StaticResource Muted}" HorizontalAlignment="Center" Margin="0,0,0,14" />
                <ProgressBar IsIndeterminate="True" Height="8" />
            </StackPanel>
        </Border>
    </Border>
    </Grid>
</Window>