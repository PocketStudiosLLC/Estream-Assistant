<Window x:Class="EstreamAssistant.App.Views.HelpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:v="clr-namespace:EstreamAssistant.App.Views"
        Title="How to use eStream Assistant"
        Width="760" Height="720" MinWidth="560" MinHeight="400"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource Panel}">
    <Window.Resources>
        <!-- One explanation box; search results also say which help tab it's from. -->
        <DataTemplate x:Key="SectionCard" DataType="{x:Type v:HelpSection}">
            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                <StackPanel>
                    <TextBlock Text="{Binding Group}" FontSize="12" Foreground="{StaticResource Muted}" Margin="0,0,0,2"
                               Visibility="{Binding Tag, RelativeSource={RelativeSource AncestorType=ItemsControl}, Converter={StaticResource Visible}}" />
                    <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" Foreground="{StaticResource AccentText}" />
                    <TextBlock Text="{Binding Text}" FontSize="15" TextWrapping="Wrap" Margin="0,4,0,4" />
                    <ItemsControl ItemsSource="{Binding Examples}">
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <Button Style="{StaticResource ChoiceButton}" Click="Example_Click" Tag="{Binding}"
                                        ToolTip="Put this in the chat box">
                                    <TextBlock Text="{Binding StringFormat=“{0}”}" FontSize="15" TextWrapping="Wrap" />
                                </Button>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                </StackPanel>
            </Border>
        </DataTemplate>
    </Window.Resources>
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="How to use eStream Assistant" FontSize="22" FontWeight="SemiBold" />
        <DockPanel DockPanel.Dock="Top" Margin="0,10,0,6">
            <Button x:Name="ClearSearch" DockPanel.Dock="Right" Content="Clear" Click="ClearSearch_Click" Margin="6,0,0,0" Padding="12,2"
                    Visibility="Collapsed" />
            <Grid>
                <TextBox x:Name="SearchBox" FontSize="16" MinHeight="34" VerticalContentAlignment="Center" Padding="6,0"
                         TextChanged="SearchBox_TextChanged" ToolTip="Type a word or a question, like stock sheet or check inventory counts" />
                <TextBlock Text="Search help, e.g. stock sheet or check inventory counts" IsHitTestVisible="False" FontSize="16"
                           Foreground="{StaticResource Muted}" Margin="10,0,0,0" VerticalAlignment="Center">
                    <TextBlock.Style>
                        <Style TargetType="TextBlock">
                            <Setter Property="Visibility" Value="Collapsed" />
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding Text, ElementName=SearchBox}" Value="">
                                    <Setter Property="Visibility" Value="Visible" />
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </TextBlock.Style>
                </TextBlock>
            </Grid>
        </DockPanel>
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,12,0,0">
            <Button Content="Close" IsCancel="True" IsDefault="True" MinWidth="110" Click="Close_Click" />
        </StackPanel>
        <Grid>
            <TabControl x:Name="HelpTabs">
                <TabItem Header="  What you can do  ">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="Ask in your own words; capitals and spelling don't matter. Click an example to put it in the chat box. Nothing changes in eStream until you press SAVE." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Sections" ItemTemplate="{StaticResource SectionCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
                <TabItem Header="  The tabs  ">
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,0,0,12"
                                   Text="What each tab along the bottom of the app is for, and a few words you'll see." />
                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                            <ItemsControl x:Name="Tabs" ItemTemplate="{StaticResource SectionCard}" />
                        </ScrollViewer>
                    </DockPanel>
                </TabItem>
            </TabControl>
            <DockPanel x:Name="ResultsPanel" Visibility="Collapsed">
                <TextBlock x:Name="NoResults" DockPanel.Dock="Top" Visibility="Collapsed" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}"
                           Text="Nothing in the help matches that. Try a shorter word, or just ask Claude in the chat box." />
                <ScrollViewer VerticalScrollBarVisibility="Auto">
                    <!-- Tag set: the cards show which help tab they're from -->
                    <ItemsControl x:Name="Results" ItemTemplate="{StaticResource SectionCard}" Tag="True" />
                </ScrollViewer>
            </DockPanel>
        </Grid>
    </DockPanel>
</Window>
