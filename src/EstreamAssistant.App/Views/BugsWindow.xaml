<Window x:Class="EstreamAssistant.App.Views.BugsWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:log="clr-namespace:EstreamAssistant.Core.Logging;assembly=EstreamAssistant.Core"
        Title="Bugs and problems"
        Width="820" Height="640" MinWidth="560" MinHeight="380"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource Panel}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Bugs and problems" FontSize="22" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,6,0,12"
                   Text="Errors and problems eStream Assistant ran into while doing a task, newest first. They're also saved in a text file you can send in with a bug report." />
        <DockPanel DockPanel.Dock="Bottom" Margin="0,12,0,0">
            <Button DockPanel.Dock="Right" Content="Close" IsCancel="True" IsDefault="True" MinWidth="110" Click="Close_Click" />
            <Button DockPanel.Dock="Left" Content="Open file location" Style="{StaticResource PrimaryButton}" MinWidth="170" Click="OpenLocation_Click"
                    ToolTip="Opens the folder with issues.txt in File Explorer, with the file selected" />
            <Button DockPanel.Dock="Left" Content="Clear list…" Click="Clear_Click" Margin="8,0,0,0"
                    ToolTip="Empty the list and the text file" />
            <TextBlock x:Name="FilePath" VerticalAlignment="Center" Margin="12,0" FontSize="12" Foreground="{StaticResource Muted}"
                       TextTrimming="CharacterEllipsis" />
        </DockPanel>
        <Grid>
            <TextBlock x:Name="Empty" Text="No problems so far." FontSize="16" Foreground="{StaticResource Muted}"
                       HorizontalAlignment="Center" VerticalAlignment="Center" Visibility="Collapsed" />
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <ItemsControl x:Name="List">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate DataType="{x:Type log:Issue}">
                            <Border Style="{StaticResource Card}" Padding="12,10" Margin="0,0,0,10">
                                <StackPanel>
                                    <DockPanel>
                                        <TextBlock DockPanel.Dock="Right" Text="{Binding TimeText}" FontSize="12" Foreground="{StaticResource Muted}" VerticalAlignment="Center" />
                                        <TextBlock Text="{Binding Area}" FontSize="15" FontWeight="SemiBold" Foreground="{StaticResource Warning}" />
                                    </DockPanel>
                                    <TextBox Text="{Binding Message, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="15" Margin="0,4,0,0"
                                             Background="Transparent" BorderThickness="0" Padding="0" Foreground="{StaticResource Text}" />
                                    <Expander Header="Details" Margin="0,6,0,0" Foreground="{StaticResource Muted}"
                                              Visibility="{Binding HasDetail, Converter={StaticResource Visible}}">
                                        <TextBox Text="{Binding Detail, Mode=OneWay}" IsReadOnly="True" TextWrapping="Wrap" FontSize="12" FontFamily="Consolas"
                                                 MaxHeight="240" VerticalScrollBarVisibility="Auto" Margin="0,4,0,0" />
                                    </Expander>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </DockPanel>
</Window>
