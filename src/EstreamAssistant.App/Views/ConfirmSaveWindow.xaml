<Window x:Class="EstreamAssistant.App.Views.ConfirmSaveWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Save to eStream?" Width="720" SizeToContent="Height" MaxHeight="700"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource Panel}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" Text="Save these changes to eStream?" FontSize="22" FontWeight="SemiBold" />
        <TextBlock DockPanel.Dock="Top" x:Name="Intro" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,6,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Orientation="Horizontal" HorizontalAlignment="Right" Margin="0,16,0,0">
            <Button x:Name="SaveButton" Style="{StaticResource SaveButton}" Click="Save_Click" MinWidth="170" />
            <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="110" Click="Cancel_Click" />
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="430">
                <ItemsControl x:Name="Lines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="18" TextWrapping="Wrap" Margin="0,3" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
