<Window x:Class="EstreamAssistant.App.Views.ConfirmActionWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Width="720" SizeToContent="Height" MaxHeight="720"
        WindowStartupLocation="CenterOwner" ResizeMode="NoResize" ShowInTaskbar="False"
        Style="{StaticResource {x:Type Window}}" Background="{StaticResource Panel}">
    <DockPanel Margin="20">
        <TextBlock DockPanel.Dock="Top" x:Name="Heading" FontSize="22" FontWeight="SemiBold" TextWrapping="Wrap" />
        <TextBlock DockPanel.Dock="Top" x:Name="Intro" TextWrapping="Wrap" FontSize="15" Foreground="{StaticResource Muted}" Margin="0,6,0,12" />
        <StackPanel DockPanel.Dock="Bottom" Margin="0,14,0,0">
            <StackPanel x:Name="TypePanel" Orientation="Horizontal" Margin="0,0,0,12" Visibility="Collapsed">
                <TextBlock x:Name="TypeLabel" VerticalAlignment="Center" FontSize="16" Margin="0,0,10,0" />
                <TextBox x:Name="TypeBox" Width="160" FontSize="18" MinHeight="36" TextChanged="TypeBox_TextChanged" PreviewKeyDown="TypeBox_KeyDown" />
            </StackPanel>
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button x:Name="OkButton" Style="{StaticResource SaveButton}" Click="Ok_Click" MinWidth="170" />
                <Button Content="Cancel" IsCancel="True" IsDefault="True" MinWidth="110" Click="Cancel_Click" />
            </StackPanel>
        </StackPanel>
        <Border Style="{StaticResource Card}" Padding="12" Margin="0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" MaxHeight="380">
                <ItemsControl x:Name="Lines">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <TextBlock Text="{Binding}" FontSize="16" TextWrapping="Wrap" Margin="0,2" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>
    </DockPanel>
</Window>
