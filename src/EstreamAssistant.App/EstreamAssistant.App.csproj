<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <!-- Windows 10 SDK: Windows.Data.Pdf draws typed PDF invoices on the Pending tab. -->
    <TargetFramework>net10.0-windows10.0.19041.0</TargetFramework>
    <SupportedOSPlatformVersion>10.0.17763.0</SupportedOSPlatformVersion>
    <UseWPF>true</UseWPF>
    <!-- Lets the app compile on the Linux/macOS dev PC. It only RUNS on Windows. -->
    <EnableWindowsTargeting>true</EnableWindowsTargeting>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <RootNamespace>EstreamAssistant.App</RootNamespace>
    <AssemblyName>EstreamAssistant</AssemblyName>
    <Product>eStream Assistant</Product>
    <Version>0.2.8</Version>
    <ApplicationManifest>app.manifest</ApplicationManifest>
    <ApplicationIcon>app.ico</ApplicationIcon>
  </PropertyGroup>

  <!-- Store PC deployment (Plan.txt sec. 14):
       dotnet publish src/EstreamAssistant.App -c Release -r win-x64 -->
  <PropertyGroup Condition="'$(RuntimeIdentifier)' == 'win-x64'">
    <SelfContained>true</SelfContained>
    <PublishSingleFile>true</PublishSingleFile>
    <IncludeNativeLibrariesForSelfExtract>true</IncludeNativeLibrariesForSelfExtract>
  </PropertyGroup>

  <ItemGroup>
    <Using Include="System.IO" />
    <Resource Include="Fonts\*.ttf" />
    <Resource Include="app.ico" />
    <ProjectReference Include="..\EstreamAssistant.Core\EstreamAssistant.Core.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="CommunityToolkit.Mvvm" Version="8.4.2" />
    <PackageReference Include="System.Security.Cryptography.ProtectedData" Version="11.0.0" />
  </ItemGroup>

</Project>
